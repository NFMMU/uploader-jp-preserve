# GHCR image owner (lowercase GitHub username or organization).
GHCR_OWNER=nfmmu
# Image tag: latest follows the default branch; a version tag can pin a release.
IMAGE_TAG=latest
# Obtain the HTTPS endpoint and enrollment token directly from the project operator.
CENTRAL_API_URL=https://api.example.invalid
NODE_ENROLLMENT_TOKEN=replace-with-token-provided-by-operator
NODE_NAME=participant-node-01
# Set A or B according to the operator's instructions.
NODE_TYPE=B
# 10737418240 = 10 GiB. Set 0 for no participant-defined quota (disk space still limits usage).
NODE_CAPACITY_BYTES=10737418240
# Minimum time between uploader.jp HTTP requests made by this agent.
NODE_UPLOADER_MIN_INTERVAL=30s
# Persistent Docker volume name. Do not delete it during routine upgrades.
NODE_DATA_VOLUME=uploader-jp-preservation-node-data
