# ノード参加者向け。中央サービスの運営者用 .env は使わないでください。

# 公開済み GHCR イメージを使う場合の設定
GHCR_OWNER=nfmmu
IMAGE_TAG=latest

# 運営から指定された値を設定してください。
CENTRAL_API_URL=https://api.example.invalid
NODE_ENROLLMENT_TOKEN=replace-with-the-one-time-token-issued-after-approval
NODE_NAME=participant-node-01
NODE_TYPE=B

# 10737418240 = 10 GiB。0 は参加者側の容量上限なし（物理容量は有限）。
NODE_CAPACITY_BYTES=10737418240

# uploader.jp へのリクエスト開始間隔。通常は 30s のままにしてください。
NODE_UPLOADER_MIN_INTERVAL=30s

# 保存データとノード認証情報を保持するボリューム名。通常は変更しません。
NODE_DATA_VOLUME=uploader-jp-preservation-node-data
