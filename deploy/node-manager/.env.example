# GHCR image owner (lowercase GitHub username or organization).
GHCR_OWNER=nfmmu
# Image tag: latest follows the default branch; a version tag can pin a release.
IMAGE_TAG=latest
MANAGER_PORT=8780
# Used by the local-build compose.yaml only. The GHCR compose uses GHCR_OWNER and IMAGE_TAG.
NODE_AGENT_IMAGE=archive-node-agent:local
NODE_DATA_VOLUME=archive-node-data
ALLOW_INSECURE_HTTP=true
