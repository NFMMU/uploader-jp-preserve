# Local Docker Compose development only. Never reuse these values in production.
APP_ENV=development
POSTGRES_PASSWORD=archive-dev-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL_HOURS=12
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-this-bootstrap-password

# Local development only: shared token for demo containers.
# The API rejects this setting when APP_ENV=production. Real participants use
# an approved request-specific one-time token; never share this dev token.
DEV_NODE_ENROLLMENT_TOKEN=local-node-enrollment-token-change-me
# Optional proxy CIDRs for forwarded client IPs; configure narrowly in production.
TRUSTED_PROXIES=

# Local demo nodes. Real participants use deploy/participant-node/compose.yaml
# and a one-time token issued after their public participation request is approved.
NODE_NAME=local-node-a
NODE_TYPE=A
NODE_CAPACITY_BYTES=10737418240
NODE_NAME_B=local-node-b
NODE_CAPACITY_BYTES_B=10737418240
NODE_NAME_C=local-node-c
NODE_CAPACITY_BYTES_C=10737418240
NODE_NAME_D=local-node-d
NODE_CAPACITY_BYTES_D=10737418240

# Minimum interval between uploader.jp HTTP requests per agent, not global.
NODE_UPLOADER_MIN_INTERVAL=30s
