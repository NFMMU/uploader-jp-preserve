APP_ENV=development
APP_ADDR=:8080
DATABASE_URL=postgres://archive:archive-dev-password@localhost:5432/archive?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL_HOURS=12
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-this-bootstrap-password
# Node-agent settings (set on each participating node)
NODE_ID=
NODE_STORAGE_PATH=/srv/archive-data
NODE_CAPACITY_BYTES=10737418240