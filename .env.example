# 運営者・開発者向け。中央サービスのローカル動作確認用です。
# 参加ノードにはこのファイルや、作成した .env を渡さないでください。
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-local-db-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_TTL_HOURS=12

# Cloudflare Turnstile: 公開フォームのボット対策。Cloudflare ダッシュボードで取得します。
# 本番 (APP_ENV=production) では必須です。ローカル開発では空欄なら認証を省略します。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 初回起動時に管理者を作成します。起動前に必ず変更してください。
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# ローカルのデモノード用。実際の参加者には申請ごとの一回限りのトークンを発行します。
DEV_NODE_ENROLLMENT_TOKEN=replace-with-a-long-local-demo-token

# パスワード付き取得元を使う場合のみ設定します。64桁の16進数を指定します。
# 生成例: openssl rand -hex 32
# 変更すると、以前保存した取得元パスワードを復号できなくなります。
SOURCE_PASSWORD_ENCRYPTION_KEY=

# LibreDesk 連携を使う場合のみ設定します。使わない場合は空欄のままにします。
LIBREDESK_BASE_URL=
LIBREDESK_API_KEY=
LIBREDESK_API_SECRET=
LIBREDESK_INBOX_ID=
LIBREDESK_TEAM_ID=
LIBREDESK_AGENT_ID=
LIBREDESK_FALLBACK_CONTACT_EMAIL=uploaderjp-archive@udonya.moe
LIBREDESK_CONVERSATION_URL_TEMPLATE={{base_url}}/app/inbox/conversations/{{uuid}}

# リバースプロキシ経由で公開する場合に限り、信頼するプロキシの CIDR を狭く指定します。
TRUSTED_PROXIES=
