{
	"name": "uploader-jp-archive-web",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vike dev --host 0.0.0.0",
		"build": "tsc -b && vike build",
		"start": "node dist/server/index.mjs",
		"start:ogp": "node other_scripts/og-server.mjs",
		"preview": "vike preview --host 0.0.0.0",
		"lint": "biome check --write",
		"format": "biome format",
		"test": "node --test",
		"test:watch": "node --watch --test",
		"lint:check": "biome check --changed --since=\"${BIOME_BASE_REF:?BIOME_BASE_REF must be set to the event comparison SHA}\" --no-errors-on-unmatched",
		"format:check": "biome format --changed --since=\"${BIOME_BASE_REF:?BIOME_BASE_REF must be set to the event comparison SHA}\" --no-errors-on-unmatched",
		"lint:check:local": "biome check .",
		"format:check:local": "biome format ."
	},
	"dependencies": {
		"@fontsource/noto-color-emoji": "^5.3.2",
		"@fontsource/noto-sans-jp": "^5.3.1",
		"@fontsource/roboto": "^5.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"lucide-react": "^1.63.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.5",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2",
		"vike": "^0.4.268",
		"vike-react": "^0.6.32",
		"vite": "^8.3.5",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0"
	}
}
