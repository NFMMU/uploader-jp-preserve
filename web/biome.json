{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": "../"
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/features/public/pages/PublicFileDetail.tsx",
				"src/features/public/pages/PublicFileRow.tsx",
				"src/features/review/AuthorArtifacts.tsx",
				"src/features/review/Catalog.tsx",
				"src/features/review/RequestDetailPage.tsx",
				"src/style.css",
				"src/types/public.ts"
			],
			"formatter": {
				"enabled": false
			}
		}
	]
}
