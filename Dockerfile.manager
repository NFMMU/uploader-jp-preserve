FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/node-manager ./cmd/node-manager
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/node-manager ./cmd/node-manager

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /out/node-manager /node-manager
ENV LISTEN_ADDR=:8080 \
    MANAGER_CONFIG_DIR=/var/lib/archive-node-manager \
    DOCKER_SOCKET=/var/run/docker.sock \
    NODE_AGENT_IMAGE=archive-node-agent:local \
    NODE_DATA_VOLUME=archive-node-data
EXPOSE 8080
ENTRYPOINT ["/node-manager"]
